# =============================================================================
# {{ project_name }} - Application Secrets
# =============================================================================
# Copy this file to app-secrets.env and fill in your values.
# NEVER commit app-secrets.env to version control.

# Identity provider: the issuer whose JWTs the backend accepts. It is not a secret, and the backend holds
# no JWT signing secret. Never deploy with the `local` Spring profile (the development identity).
IDENTITY_PROVIDER_ISSUER_URI=https://your-identity-provider.example/
# The audience of this API in the provider's access tokens. The backend refuses to start with an issuer and no
# audience, and rejects a token that names another API. An agent service of the workspace takes the same value
# as AGENT_OIDC_AUDIENCE.
IDENTITY_PROVIDER_AUDIENCE=https://your-api.example/

# Add any additional API keys below:
# SOME_API_KEY=
