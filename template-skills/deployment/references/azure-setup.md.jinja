      - bash 06-deploy-backend.sh {% raw %}{{.CLI_ARGS}}{% endraw %}
      - bash 07-show-deployment-info.sh {% raw %}{{.CLI_ARGS}}{% endraw %}

  infra:update-backend:
    desc: "Rebuild and redeploy backend (zero-downtime)"
    dir: ./infra/azure
    cmds:
      - bash update-backend.sh {% raw %}{{.CLI_ARGS}}{% endraw %}

  infra:info:
    desc: "Show deployment information"
