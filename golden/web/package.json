{
  "name": "prism-golden-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../shared/api-contracts/openapi.yml -o lib/api/generated/schema.d.ts",
    "predev": "npm run generate:api",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "prebuild": "npm run generate:api",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "prelint": "npm run generate:api",
    "lint": "eslint . --max-warnings 0",
    "pretypecheck": "npm run generate:api",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest": "npm run generate:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"const fs=require('fs');['.next'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\""
  },
  "dependencies": {
    "next": "16.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
