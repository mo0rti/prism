# The environment of the agent service. Export these in your shell or set them in your secret store.
# This file is documentation: nothing reads it, and a real value never belongs in git.

# --- Local development: accept the tokens of the backend's local development identity ---
# The backend (profile `local`) publishes the public key that verifies them at /api/dev-identity/jwks.
AGENT_PROFILE=local
# The backend the tools call with the signed-in user's own token. Under `local` it must be a loopback URL.
# 8080 is the first backend's port; set the port of your backend when it differs.
AGENT_BACKEND_BASE_URL=http://localhost:8080

# --- Anywhere else: a real identity provider (never together with AGENT_PROFILE=local) ---
# AGENT_OIDC_ISSUER=https://idp.example.com/
# AGENT_OIDC_AUDIENCE=https://agent.example.com
# AGENT_OIDC_JWKS_URI=            # optional: otherwise the issuer's OpenID discovery document names it
# AGENT_BACKEND_BASE_URL=https://api.example.com

# --- Model provider ---
# `fake` (the default) is deterministic and needs no key. `claude` calls the Claude API.
# AGENT_PROVIDER=claude
# AGENT_CLAUDE_MODEL=claude-sonnet-5-5
# AGENT_CLAUDE_MAX_TOKENS=1024
# The key is read from this variable only. Never write it in a file of the repository.
# ANTHROPIC_API_KEY=

# --- Safety limits (per user, in memory, per process) ---
# AGENT_BUDGET_REQUESTS=20
# AGENT_BUDGET_TOKENS=50000
# AGENT_BUDGET_WINDOW_SECONDS=3600
# AGENT_MAX_TOOL_CALLS=4
