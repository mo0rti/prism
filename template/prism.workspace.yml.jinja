schema_version: 2
{# The CLI passes its own version; a raw Copier run without the CLI names no minimum. #}
min_prism_cli_version: {{ (_prism_cli_version | default('0.0.0', true) | string) | tojson }}
generated_by:
  tool: prism-cli
  prism_cli_version: {{ (_prism_cli_version | default('unknown', true) | string) | tojson }}
  template_source: {{ (_copier_conf.src_path | default('unknown', true) | string) | tojson }}
  template_version: {{ (_copier_conf.vcs_ref | default('unknown', true) | string) | tojson }}
  template_commit: {{ (_copier_conf.vcs_ref_hash | default('unknown', true) | string) | tojson }}
  generated_at: "{% now 'utc', '%Y-%m-%dT%H:%M:%SZ' %}"
project:
  name: {{ project_name | tojson }}
  slug: {{ project_slug | tojson }}
  package_identifier: {{ package_identifier | tojson }}
  description: {{ description | tojson }}
paths:
  wiki_root: knowledge/wiki
  intake_root: knowledge/intake
  advisory_board: knowledge/wiki/advisory/BOARD.md
expected_surfaces:
  ai:
    - AGENTS.md
    - CLAUDE.md
    - .agents/skills
    - .claude/commands
    - .cursor/rules
  docs:
    - README.md
    - docs/
  workflows: []
