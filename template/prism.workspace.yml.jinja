schema_version: 2
{# The CLI passes its own version; a raw Copier run without the CLI names no minimum. #}
min_prism_cli_version: {{ (_prism_cli_version | default('0.0.0', true) | string) | tojson }}
generated_by:
  tool: prism-cli
  prism_cli_version: {{ (_prism_cli_version | default('unknown', true) | string) | tojson }}
  template_source: {{ (_copier_conf.src_path | default('unknown', true) | string) | tojson }}
  template_version: {{ (_copier_conf.vcs_ref | default('unknown', true) | string) | tojson }}
  template_commit: {{ (_copier_conf.vcs_ref_hash | default('unknown', true) | string) | tojson }}
  generated_at: "{% now 'utc', '%Y-%m-%dT%H:%M:%SZ' %}"
project:
  name: {{ project_name | tojson }}
  slug: {{ project_slug | tojson }}
  package_identifier: {{ package_identifier | tojson }}
  description: {{ description | tojson }}
  auth_methods:
{% for auth_method in auth_methods %}
    - {{ auth_method }}
{% endfor %}
  github_org: {{ github_org | tojson }}
{% set stacks = {"backend": "spring-backend", "web-user-app": "nextjs-web", "web-admin-portal": "nextjs-web", "mobile-android": "android-compose", "mobile-ios": "ios-swiftui"} %}
{% set labels = {"backend": "Spring Boot Backend", "web-user-app": "User-Facing Web App", "web-admin-portal": "Admin Web Portal", "mobile-android": "Android (Kotlin/Compose)", "mobile-ios": "iOS (Swift/SwiftUI)"} %}
apps:
{% for platform in platforms %}
  - id: {{ platform }}
    name: {{ labels[platform] | tojson }}
    stack: {{ stacks[platform] }}
    repository: workspace
    path: {{ platform }}
{% endfor %}
app_maturity:
{% for platform in platforms %}
  {{ platform }}:
{% if platform == "mobile-ios" %}
    level: experimental
    caveat: "Generated iOS structure requires local macOS/Xcode validation before treating it as build-proven."
{% elif platform == "web-user-app" or platform == "web-admin-portal" %}
    level: provisional
    caveat: "Generated web apps are verified by lint, typecheck and build only; hosting is the project owner's choice (see the deployment skill)."
{% else %}
    level: baseline
    caveat: ""
{% endif %}
{% endfor %}
paths:
  wiki_root: knowledge/wiki
  intake_root: knowledge/intake
  advisory_board: knowledge/wiki/advisory/BOARD.md
expected_surfaces:
  ai:
    - AGENTS.md
    - CLAUDE.md
    - .agents/skills
    - .claude/commands
    - .cursor/rules
  docs:
    - README.md
    - docs/
  workflows:
{% if "backend" in platforms %}
    - .github/workflows/backend.yml
{% endif %}
{% if "web-user-app" in platforms %}
    - .github/workflows/web-user-app.yml
{% endif %}
{% if "web-admin-portal" in platforms %}
    - .github/workflows/web-admin-portal.yml
{% endif %}
{% if "mobile-android" in platforms %}
    - .github/workflows/mobile-android.yml
{% endif %}
{% if "mobile-ios" in platforms %}
    - .github/workflows/mobile-ios.yml
{% endif %}
