# =============================================================================
# Backend database (docker-compose.yml `db` service; the backend defaults to the same values)
# =============================================================================
DATABASE_NAME={{ project_slug | replace('-', '_') }}
DATABASE_USERNAME={{ project_slug | replace('-', '_') }}
DATABASE_PASSWORD=localdev
{% endif %}
