name: {{ project_slug }}

services:
{% if "spring-backend" in stacks %}{% for app in apps if app.stack == "spring-backend" %}  {{ app.id }}:
    build:
      context: {{ ('./' ~ app.path) | tojson }}
      dockerfile: Dockerfile
    ports:
      - "127.0.0.1:{{ app.port }}:{{ app.port }}"
    # No Spring profile is set here: a container never runs the `local` development identity.
    environment:
      PORT: "{{ app.port }}"
      DATABASE_URL: jdbc:postgresql://db:5432/${DATABASE_NAME:-{{ project_slug | replace('-', '_') }}}
      DATABASE_USERNAME: ${DATABASE_USERNAME:-{{ project_slug | replace('-', '_') }}}
      DATABASE_PASSWORD: ${DATABASE_PASSWORD:-localdev}
    depends_on:
      db:
        condition: service_healthy

{% endfor %}  db:
    image: postgres:{{ pack_versions['spring-backend'].postgres }}
    environment:
      POSTGRES_DB: ${DATABASE_NAME:-{{ project_slug | replace('-', '_') }}}
      POSTGRES_USER: ${DATABASE_USERNAME:-{{ project_slug | replace('-', '_') }}}
      POSTGRES_PASSWORD: ${DATABASE_PASSWORD:-localdev}
    # The password is a known development default: every published port stays on this machine (127.0.0.1).
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DATABASE_USERNAME:-{{ project_slug | replace('-', '_') }}}"]
      interval: 5s
      timeout: 5s
      retries: 5

{% endif %}

volumes:
{% if "spring-backend" in stacks %}
  pgdata:
{% endif %}
