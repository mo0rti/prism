import Foundation

// MARK: - Auth

struct OAuthCallbackRequest: Codable {
    let provider: String
    let code: String
    let redirectUri: String
}

{% if "password" in auth_methods %}
struct RegisterRequest: Codable {
    let email: String
    let password: String
    let displayName: String
}

struct LoginRequest: Codable {
    let email: String
    let password: String
}
{% endif %}

struct RefreshTokenRequest: Codable {
    let refreshToken: String
}

struct AuthResponse: Codable {
    let accessToken: String
    let refreshToken: String
    let expiresIn: Int
    let user: UserResponse
}

struct UserResponse: Codable, Identifiable {
    let id: String
    let email: String
    let displayName: String
    let avatarUrl: String?
    let authProvider: String
    let role: String
}

// MARK: - Transactions
// Wire shapes of the backend `/transactions` endpoints (see shared/api-contracts/openapi.yml).
// The sample feature shows each transaction as an `Example` row.

struct TransactionResponse: Codable, Identifiable {
    let id: String
    let reference: String
    let amount: Double
    let currency: String
    let description: String?
    let type: String
    let status: String
    let createdBy: String
    let createdAt: String
    let updatedAt: String

    func toDomain() -> Example {
        Example(
            id: id,
            title: "\(type) \(String(format: "%.2f", amount)) \(currency)",
            description: description,
            status: status,
            createdBy: createdBy,
            createdAt: createdAt,
            updatedAt: updatedAt
        )
    }
}

struct TransactionListResponse: Codable {
    let content: [TransactionResponse]
    let page: Int
    let size: Int
    let totalElements: Int
    let totalPages: Int

    func toDomain() -> ExamplePage {
        ExamplePage(
            content: content.map { $0.toDomain() },
            page: page,
            size: size,
            totalElements: totalElements,
            totalPages: totalPages
        )
    }
}

struct CreateTransactionRequest: Codable {
    let amount: Double
    let currency: String
    let description: String?
    let type: String
}

struct UpdateTransactionRequest: Codable {
    let description: String?
    let status: String?
}

// MARK: - Examples (sample feature domain models)

struct Example: Identifiable {
    let id: String
    let title: String
    let description: String?
    let status: String
    let createdBy: String
    let createdAt: String
    let updatedAt: String
}

struct ExamplePage {
    let content: [Example]
    let page: Int
    let size: Int
    let totalElements: Int
    let totalPages: Int
}
