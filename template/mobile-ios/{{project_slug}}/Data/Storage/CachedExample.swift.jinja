import Foundation
import SwiftData

@Model
final class CachedExample {
    @Attribute(.unique) var id: String
    var title: String
    var descriptionText: String?
    var status: String
    var createdBy: String
    var createdAt: String
    var updatedAt: String
    var cachedAt: Date

    init(
        id: String,
        title: String,
        descriptionText: String? = nil,
        status: String,
        createdBy: String,
        createdAt: String,
        updatedAt: String,
        cachedAt: Date = .now
    ) {
        self.id = id
        self.title = title
        self.descriptionText = descriptionText
        self.status = status
        self.createdBy = createdBy
        self.createdAt = createdAt
        self.updatedAt = updatedAt
        self.cachedAt = cachedAt
    }

    /// Convert from the domain model
    static func from(_ example: Example) -> CachedExample {
        CachedExample(
            id: example.id,
            title: example.title,
            descriptionText: example.description,
            status: example.status,
            createdBy: example.createdBy,
            createdAt: example.createdAt,
            updatedAt: example.updatedAt
        )
    }

    /// Convert to the domain model
    func toExample() -> Example {
        Example(
            id: id,
            title: title,
            description: descriptionText,
            status: status,
            createdBy: createdBy,
            createdAt: createdAt,
            updatedAt: updatedAt
        )
    }
}
