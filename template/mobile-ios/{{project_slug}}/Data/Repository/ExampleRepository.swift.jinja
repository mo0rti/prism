import Foundation

/// Sample repository backed by the backend `/transactions` endpoints.
/// Each transaction is exposed as an `Example` row.
protocol ExampleRepository: Sendable {
    func list(page: Int, size: Int) async throws -> ExamplePage
    func getById(_ id: String) async throws -> Example
    func create(amount: Double, currency: String, type: String, description: String?) async throws -> Example
    func update(id: String, description: String?, status: String?) async throws -> Example
    func delete(_ id: String) async throws
}

final class ExampleRepositoryImpl: ExampleRepository, Sendable {
    private let apiClient: APIClient

    init(apiClient: APIClient) {
        self.apiClient = apiClient
    }

    func list(page: Int = 0, size: Int = 20) async throws -> ExamplePage {
        let response: TransactionListResponse = try await apiClient.request(.listTransactions(page: page, size: size))
        return response.toDomain()
    }

    func getById(_ id: String) async throws -> Example {
        let response: TransactionResponse = try await apiClient.request(.getTransaction(id: id))
        return response.toDomain()
    }

    func create(amount: Double, currency: String, type: String, description: String?) async throws -> Example {
        let body = CreateTransactionRequest(amount: amount, currency: currency, description: description, type: type)
        let response: TransactionResponse = try await apiClient.request(.createTransaction(), body: body)
        return response.toDomain()
    }

    func update(id: String, description: String?, status: String?) async throws -> Example {
        let body = UpdateTransactionRequest(description: description, status: status)
        let response: TransactionResponse = try await apiClient.request(.updateTransaction(id: id), body: body)
        return response.toDomain()
    }

    func delete(_ id: String) async throws {
        try await apiClient.requestVoid(.deleteTransaction(id: id))
    }
}
