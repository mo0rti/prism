package {{ package_identifier }}.core.network

import android.security.NetworkSecurityPolicy
import org.junit.Assert.assertFalse
import org.junit.Assert.assertTrue
import org.junit.Test

/**
 * Instrumentation tests build the debug variant, so this checks the `src/debug` network
 * security overlay: cleartext only for the emulator host alias and localhost.
 */
class CleartextPolicyTest {

    private val policy get() = NetworkSecurityPolicy.getInstance()

    @Test
    fun debugBuildPermitsCleartextToEmulatorHostAndLocalhost() {
        assertTrue(policy.isCleartextTrafficPermitted("10.0.2.2"))
        assertTrue(policy.isCleartextTrafficPermitted("localhost"))
    }

    @Test
    fun debugBuildStillBlocksCleartextToOtherHosts() {
        assertFalse(policy.isCleartextTrafficPermitted("api.example.com"))
        assertFalse(policy.isCleartextTrafficPermitted("192.168.1.10"))
    }
}
