package {{ package_identifier }}.core.network

import {{ package_identifier }}.core.datastore.TokenStorage
import {{ package_identifier }}.core.di.ApiBaseUrl
import {{ package_identifier }}.feature.auth.data.remote.dto.AuthResponse
import {{ package_identifier }}.feature.auth.data.remote.dto.RefreshTokenRequest
import kotlinx.coroutines.flow.first
import kotlinx.coroutines.runBlocking
import kotlinx.serialization.json.Json
import okhttp3.Authenticator
import okhttp3.HttpUrl
import okhttp3.HttpUrl.Companion.toHttpUrl
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.OkHttpClient
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody
import okhttp3.Response
import okhttp3.Route
import javax.inject.Inject
import javax.inject.Singleton

/**
 * Handles 401 responses by attempting a token refresh.
 * If the refresh succeeds, the original request is retried with the new token.
 * If the backend rejects the refresh token (400, 401 or 403), the session is cleared and the
 * user is logged out. If the refresh cannot be completed (timeout, I/O error, 5xx or any other
 * status), the stored session is kept so a later request can try again.
 */
@Singleton
class TokenAuthenticator internal constructor(
    private val tokenStorage: TokenStorage,
    private val json: Json,
    apiBaseUrl: String,
    private val refreshClient: OkHttpClient,
) : Authenticator {

    // The refresh client carries no interceptors or authenticator, so a refresh can never
    // recurse into this class.
    @Inject
    constructor(
        tokenStorage: TokenStorage,
        json: Json,
        @ApiBaseUrl apiBaseUrl: String,
    ) : this(tokenStorage, json, apiBaseUrl, OkHttpClient.Builder().build())

    private val refreshUrl: HttpUrl = apiBaseUrl.toHttpUrl().newBuilder()
        .addPathSegments("auth/refresh")
        .build()

    private sealed interface RefreshOutcome {
        data class Refreshed(val access: String, val refresh: String) : RefreshOutcome
        data object Rejected : RefreshOutcome
        data object Unavailable : RefreshOutcome
    }

    @Synchronized
    override fun authenticate(route: Route?, response: Response): Request? {
        val requestSession = response.request.tag(SessionIdentity::class.java)?.id ?: return null
        val tokens = runBlocking { tokenStorage.tokens.first() }
        if (tokens.sessionId != requestSession) return null
        val access = tokens.accessToken
        val refresh = tokens.refreshToken
        if (access != null && response.request.header("Authorization") != "Bearer $access") {
            return retry(response.request, access)
        }
        if (refresh == null || response.request.header("X-Retry-Auth") != null) {
            runBlocking { tokenStorage.replaceIfCurrent(tokens, null, null) }
            return null
        }
        val outcome = try {
            executeRefresh(refresh)
        } catch (_: Exception) {
            RefreshOutcome.Unavailable
        }
        // A login/logout outside this lock must not be overwritten by a delayed
        // refresh response. DataStore performs the comparison and write atomically.
        val replaced = when (outcome) {
            is RefreshOutcome.Refreshed -> runBlocking {
                tokenStorage.replaceIfCurrent(tokens, outcome.access, outcome.refresh)
            }
            // The backend refused the refresh token: this session cannot recover.
            RefreshOutcome.Rejected -> runBlocking { tokenStorage.replaceIfCurrent(tokens, null, null) }
            // The refresh did not complete: keep the session and let the caller see the 401.
            RefreshOutcome.Unavailable -> false
        }
        if (replaced) return (outcome as? RefreshOutcome.Refreshed)?.let { retry(response.request, it.access) }
        val latest = runBlocking { tokenStorage.tokens.first() }
        if (latest.sessionId != requestSession) return null
        return latest.accessToken?.takeIf { it != access }?.let { retry(response.request, it) }
    }

    private fun retry(request: Request, access: String): Request = request.newBuilder()
        .header("Authorization", "Bearer $access")
        .header("X-Retry-Auth", "true")
        .build()

    private fun executeRefresh(refreshToken: String): RefreshOutcome {
        val body = json.encodeToString(
            RefreshTokenRequest.serializer(),
            RefreshTokenRequest(refreshToken),
        )

        val request = Request.Builder()
            .url(refreshUrl)
            .post(body.toRequestBody("application/json".toMediaType()))
            .build()

        refreshClient.newCall(request).execute().use { response ->
            if (response.isSuccessful) {
                val responseBody = response.body?.string() ?: return RefreshOutcome.Unavailable
                val authResponse = json.decodeFromString(AuthResponse.serializer(), responseBody)
                return RefreshOutcome.Refreshed(authResponse.accessToken, authResponse.refreshToken)
            }
            return if (response.code in REJECTED_STATUS_CODES) RefreshOutcome.Rejected else RefreshOutcome.Unavailable
        }
    }

    private companion object {
        val REJECTED_STATUS_CODES = setOf(400, 401, 403)
    }
}
