package {{ package_identifier }}.feature.example.data.remote.dto

import {{ package_identifier }}.feature.example.domain.model.Example
import kotlinx.serialization.Serializable
import java.util.Locale

// Wire shapes of the backend `/transactions` endpoints (see shared/api-contracts/openapi.yml).
// The sample feature shows each transaction as an `Example` row.

@Serializable
data class TransactionResponse(
    val id: String,
    val reference: String,
    val amount: Double,
    val currency: String,
    val description: String? = null,
    val type: String,
    val status: String,
    val createdBy: String,
    val createdAt: String,
    val updatedAt: String,
) {
    fun toDomain(): Example = Example(
        id = id,
        title = "$type ${String.format(Locale.ROOT, "%.2f", amount)} $currency",
        description = description,
        status = status,
        createdBy = createdBy,
        createdAt = createdAt,
        updatedAt = updatedAt,
    )
}

@Serializable
data class TransactionListResponse(
    val content: List<TransactionResponse>,
    val page: Int,
    val size: Int,
    val totalElements: Long,
    val totalPages: Int,
)

@Serializable
data class CreateTransactionRequest(
    val amount: Double,
    val currency: String,
    val description: String? = null,
    val type: String,
)

@Serializable
data class UpdateTransactionRequest(
    val description: String? = null,
    val status: String? = null,
)
