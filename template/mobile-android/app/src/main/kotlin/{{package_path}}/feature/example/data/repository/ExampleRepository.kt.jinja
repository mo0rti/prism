package {{ package_identifier }}.feature.example.data.repository

import {{ package_identifier }}.core.common.AppResult
import {{ package_identifier }}.core.common.appResultOf
import {{ package_identifier }}.core.model.PagedData
import {{ package_identifier }}.core.network.ApiService
import {{ package_identifier }}.feature.example.data.remote.dto.CreateTransactionRequest
import {{ package_identifier }}.feature.example.data.remote.dto.UpdateTransactionRequest
import {{ package_identifier }}.feature.example.domain.model.Example
import javax.inject.Inject
import javax.inject.Singleton

/**
 * Sample repository backed by the backend `/transactions` endpoints.
 * Each transaction is exposed as an [Example] row.
 */
@Singleton
class ExampleRepository @Inject constructor(
    private val apiService: ApiService,
) {

    suspend fun list(page: Int = 0, size: Int = 20): AppResult<PagedData<Example>> =
        appResultOf {
            val response = apiService.listTransactions(page = page, size = size)
            PagedData(
                content = response.content.map { it.toDomain() },
                page = response.page,
                size = response.size,
                totalElements = response.totalElements,
                totalPages = response.totalPages,
            )
        }

    suspend fun getById(id: String): AppResult<Example> =
        appResultOf {
            apiService.getTransaction(id).toDomain()
        }

    suspend fun create(amount: Double, currency: String, type: String, description: String?): AppResult<Example> =
        appResultOf {
            apiService.createTransaction(CreateTransactionRequest(amount, currency, description, type)).toDomain()
        }

    suspend fun update(id: String, description: String?, status: String?): AppResult<Example> =
        appResultOf {
            apiService.updateTransaction(id, UpdateTransactionRequest(description, status)).toDomain()
        }

    suspend fun delete(id: String): AppResult<Unit> =
        appResultOf {
            apiService.deleteTransaction(id)
        }
}
