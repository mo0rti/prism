package {{ package_identifier }}.core.network

import {{ package_identifier }}.core.datastore.TokenStorage
import {{ package_identifier }}.core.datastore.StoredTokens
import io.mockk.coEvery
import io.mockk.every
import io.mockk.mockk
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.serialization.json.Json
import okhttp3.OkHttpClient
import okhttp3.Protocol
import okhttp3.Request
import okhttp3.RequestBody.Companion.toRequestBody
import okhttp3.Response
import okhttp3.ResponseBody.Companion.toResponseBody
import okhttp3.mockwebserver.Dispatcher
import okhttp3.mockwebserver.MockResponse
import okhttp3.mockwebserver.MockWebServer
import okhttp3.mockwebserver.RecordedRequest
import okhttp3.mockwebserver.SocketPolicy
import org.junit.Assert.*
import org.junit.Test
import java.util.concurrent.CountDownLatch
import java.util.concurrent.Executors
import java.util.concurrent.TimeUnit
import java.util.concurrent.atomic.AtomicInteger

class TokenAuthenticatorTest {
    private val originalTokens = StoredTokens("old-access", "old-refresh", "session-a")
    private val refreshedTokens = StoredTokens("new-access", "new-refresh", "session-a")
    private val emptyTokens = StoredTokens(null, null, null)
    private val state = MutableStateFlow(originalTokens)
    private val tokenStorage = mockk<TokenStorage> {
        every { tokens } returns state
        coEvery { replaceIfCurrent(any(), any(), any()) } answers {
            val expected = firstArg<StoredTokens>()
            val access = secondArg<String?>()
            val refresh = thirdArg<String?>()
            state.compareAndSet(expected, StoredTokens(access, refresh, expected.sessionId.takeIf { access != null && refresh != null }))
        }
    }
    private val authenticator = authenticatorFor("https://api.example.com/api/v1/")

    private fun authenticatorFor(baseUrl: String, client: OkHttpClient = OkHttpClient()) =
        TokenAuthenticator(tokenStorage, Json { ignoreUnknownKeys = true }, baseUrl, client)

    private fun response(url: String = "https://api.example.com/data", retry: Boolean = false): Response =
        Response.Builder().request(Request.Builder().url(url)
            .header("Authorization", "Bearer old-access")
            .tag(SessionIdentity::class.java, SessionIdentity("session-a"))
            .apply { if (retry) header("X-Retry-Auth", "true") }.build())
            .protocol(Protocol.HTTP_1_1).code(401).message("Unauthorized")
            .body("".toResponseBody()).build()

    @Test
    fun `missing refresh token clears only the current session`() {
        state.value = originalTokens.copy(refreshToken = null)
        assertNull(authenticator.authenticate(null, response()))
        assertEquals(emptyTokens, state.value)
    }

    @Test
    fun `failed retry stops without an infinite loop`() {
        assertNull(authenticator.authenticate(null, response(retry = true)))
        assertEquals(emptyTokens, state.value)
    }

    @Test
    fun `late 401 reuses the newer access token even on a retry`() {
        state.value = refreshedTokens
        val result = authenticator.authenticate(null, response(retry = true))
        assertEquals("Bearer new-access", result?.header("Authorization"))
        assertEquals(refreshedTokens, state.value)
    }

    @Test
    fun `concurrent 401 responses consume one refresh and both retry`() {
        withRefreshServer { authenticator, url, requests ->
            val pool = Executors.newFixedThreadPool(2)
            try {
                val start = CountDownLatch(1)
                val futures = (1..2).map {
                    pool.submit<Request?> { start.await(); authenticator.authenticate(null, response(url)) }
                }
                start.countDown()
                futures.forEach { assertEquals("Bearer new-access", it.get(10, TimeUnit.SECONDS)?.header("Authorization")) }
                assertEquals(1, requests.get())
                assertEquals(refreshedTokens, state.value)
            } finally { pool.shutdownNow() }
        }
    }

    @Test
    fun `delayed refresh cannot replace a new login or resurrect logout`() {
        for (nextState in listOf(StoredTokens("login-access", "login-refresh", "session-b"), emptyTokens)) {
            state.value = originalTokens
            withRefreshServer(beforeReply = { state.value = nextState }) { authenticator, url, _ ->
                val result = authenticator.authenticate(null, response(url))
                assertEquals(nextState, state.value)
                assertNull(result)
            }
        }
    }

    @Test
    fun `old account operation is never replayed as the new login`() {
        val failed = response().let { it.newBuilder().request(it.request.newBuilder().post("old-account-operation".toRequestBody()).build()).build() }
        val newLogin = StoredTokens("login-access", "login-refresh", "session-b")
        state.value = newLogin
        assertNull(authenticator.authenticate(null, failed))
        assertEquals(newLogin, state.value)
    }

    @Test
    fun `unauthenticated login failure cannot refresh or clear an existing session`() {
        val failed = response().let { it.newBuilder().request(it.request.newBuilder().tag(SessionIdentity::class.java, null).build()).build() }
        assertNull(authenticator.authenticate(null, failed))
        assertEquals(originalTokens, state.value)
    }

    @Test
    fun `refresh rejected with 400 401 or 403 clears the session`() {
        for (code in listOf(400, 401, 403)) {
            state.value = originalTokens
            withMockServer(MockResponse().setResponseCode(code)) { authenticator, url, _ ->
                assertNull("status $code", authenticator.authenticate(null, response(url)))
                assertEquals("status $code", emptyTokens, state.value)
            }
        }
    }

    @Test
    fun `refresh failing with a server or throttling status keeps the session`() {
        for (code in listOf(429, 500, 502, 503, 504)) {
            state.value = originalTokens
            withMockServer(MockResponse().setResponseCode(code)) { authenticator, url, _ ->
                assertNull("status $code", authenticator.authenticate(null, response(url)))
                assertEquals("status $code", originalTokens, state.value)
            }
        }
    }

    @Test
    fun `refresh dropped by a connection error keeps the session`() {
        withMockServer(MockResponse().setSocketPolicy(SocketPolicy.DISCONNECT_AFTER_REQUEST)) { authenticator, url, _ ->
            assertNull(authenticator.authenticate(null, response(url)))
            assertEquals(originalTokens, state.value)
        }
    }

    @Test
    fun `refresh timeout keeps the session`() {
        val shortTimeouts = OkHttpClient.Builder()
            .readTimeout(200, TimeUnit.MILLISECONDS)
            .callTimeout(5, TimeUnit.SECONDS)
            .build()
        withMockServer(
            MockResponse().setSocketPolicy(SocketPolicy.NO_RESPONSE),
            client = shortTimeouts,
        ) { authenticator, url, _ ->
            assertNull(authenticator.authenticate(null, response(url)))
            assertEquals(originalTokens, state.value)
        }
    }

    @Test
    fun `unreadable refresh response keeps the session`() {
        withMockServer(MockResponse().setResponseCode(200).setBody("not json")) { authenticator, url, _ ->
            assertNull(authenticator.authenticate(null, response(url)))
            assertEquals(originalTokens, state.value)
        }
    }

    @Test
    fun `session survives a transient refresh failure and refreshes on the next 401`() {
        withMockServer(MockResponse().setResponseCode(503), refreshSuccess()) { authenticator, url, requests ->
            assertNull(authenticator.authenticate(null, response(url)))
            assertEquals(originalTokens, state.value)

            val retried = authenticator.authenticate(null, response(url))
            assertEquals("Bearer new-access", retried?.header("Authorization"))
            assertEquals(refreshedTokens, state.value)
            assertEquals(2, requests.get())
        }
    }

    @Test
    fun `refresh url is built from the configured base url and not from the failed request`() {
        val server = MockWebServer()
        server.enqueue(refreshSuccess())
        server.start()
        try {
            val configured = authenticatorFor(server.url("/custom/v2/").toString())
            val result = configured.authenticate(null, response("https://elsewhere.invalid/api/v1/data?private=query"))

            val recorded = server.takeRequest(5, TimeUnit.SECONDS)!!
            assertEquals("POST", recorded.method)
            assertEquals("/custom/v2/auth/refresh", recorded.path)
            assertNull(recorded.getHeader("Authorization"))
            assertEquals("Bearer new-access", result?.header("Authorization"))
        } finally { server.shutdown() }
    }

    private fun refreshSuccess() = MockResponse().setResponseCode(200).setBody(
        """{"accessToken":"new-access","refreshToken":"new-refresh","expiresIn":3600,"user":{"id":"user-1","email":"test@example.com","displayName":"Test","authProvider":"LOCAL","role":"USER"}}"""
    )

    private fun withMockServer(
        vararg responses: MockResponse,
        client: OkHttpClient = OkHttpClient(),
        test: (TokenAuthenticator, String, AtomicInteger) -> Unit,
    ) {
        val requests = AtomicInteger()
        val server = MockWebServer()
        val queue = ArrayDeque(responses.toList())
        server.dispatcher = object : Dispatcher() {
            override fun dispatch(request: RecordedRequest): MockResponse {
                requests.incrementAndGet()
                assertEquals("/api/v1/auth/refresh", request.path)
                assertTrue(request.body.readUtf8().contains("old-refresh"))
                return synchronized(queue) { queue.removeFirst() }
            }
        }
        server.start()
        try { test(authenticatorFor(server.url("/api/v1/").toString(), client), server.url("/data?private=query").toString(), requests) }
        finally { server.shutdown() }
    }

    private fun withRefreshServer(
        beforeReply: () -> Unit = {},
        test: (TokenAuthenticator, String, AtomicInteger) -> Unit,
    ) {
        val requests = AtomicInteger()
        val server = MockWebServer()
        server.dispatcher = object : Dispatcher() {
            override fun dispatch(request: RecordedRequest): MockResponse {
                requests.incrementAndGet()
                assertEquals("/api/v1/auth/refresh", request.path)
                assertTrue(request.body.readUtf8().contains("old-refresh"))
                beforeReply()
                return refreshSuccess()
            }
        }
        server.start()
        try { test(authenticatorFor(server.url("/api/v1/").toString()), server.url("/data?private=query").toString(), requests) }
        finally { server.shutdown() }
    }
}
