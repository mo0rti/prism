{% endif %}{% if "facebook" in auth_methods %}npx wrangler secret put AUTH_FACEBOOK_SECRET
{% endif %}{% if "microsoft" in auth_methods %}npx wrangler secret put AUTH_MICROSOFT_SECRET
{%- endif %}
```
