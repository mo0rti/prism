version: '3'

vars:
  PROJECT_NAME: {{ project_name }}
  OPENAPI_SPEC: ./shared/api-contracts/openapi.yml
  OPENAPI_GENERATOR: openapi-generator-cli

includes:
{% for app in apps if app.stack == "spring-backend" %}  {{ app.id }}:
    taskfile: ./{{ app.path }}/Taskfile.yml
    dir: ./{{ app.path }}
{% endfor %}
{% for app in apps if app.stack == "nextjs-web" %}  {{ app.id }}:
    taskfile: ./{{ app.path }}/Taskfile.yml
    dir: ./{{ app.path }}
{% endfor %}
{% if "android-compose" in stacks %}
  mobile-android:
    taskfile: ./mobile-android/Taskfile.yml
    dir: ./mobile-android
{% endif %}
{% if "ios-swiftui" in stacks %}
  mobile-ios:
    taskfile: ./mobile-ios/Taskfile.yml
    dir: ./mobile-ios
{% endif %}

tasks:
  # ===========================================================================
  # API Client Generation
  # ===========================================================================
  generate-clients:
    desc: "Generate typed API clients from OpenAPI spec for all platforms"
    cmds:
      - cmd: "{{'{{'}} .OPENAPI_GENERATOR {{'}}'}} validate -i {{'{{'}} .OPENAPI_SPEC {{'}}'}}"
{% for app in apps if app.stack == "spring-backend" %}      - task: generate-client-{{ app.id }}
{% endfor %}
{% for app in apps if app.stack == "nextjs-web" %}      - task: {{ app.id }}:generate-api
{% endfor %}
{% if "android-compose" in stacks %}
      - task: generate-client-mobile-android
{% endif %}
{% if "ios-swiftui" in stacks %}
      - task: generate-client-mobile-ios
{% endif %}
    sources:
      - "{{'{{'}} .OPENAPI_SPEC {{'}}'}}"

{% for app in apps if app.stack == "spring-backend" %}  generate-client-{{ app.id }}:
    desc: "Generate Spring Boot server interfaces of {{ app.id }} from OpenAPI"
    internal: true
    cmds:
      - >
        {{'{{'}} .OPENAPI_GENERATOR {{'}}'}} generate
        -i {{'{{'}} .OPENAPI_SPEC {{'}}'}}
        -g kotlin-spring
        -o ./{{ app.path }}/src/generated
        --additional-properties=interfaceOnly=true,useSpringBoot3=true,useTags=true
        --package-name="{{ package_identifier }}.{{ app.id | replace('-', '') }}.api"
{% endfor %}

{% if "android-compose" in stacks %}
  generate-client-mobile-android:
    desc: "Generate Kotlin Retrofit client from OpenAPI"
    internal: true
    cmds:
      - >
        {{'{{'}} .OPENAPI_GENERATOR {{'}}'}} generate
        -i {{'{{'}} .OPENAPI_SPEC {{'}}'}}
        -g kotlin
        -o ./mobile-android/app/src/main/java/generated
        --additional-properties=library=jvm-retrofit2,serializationLibrary=kotlinx_serialization
        --package-name="{{ package_identifier }}.api"
{% endif %}

{% if "ios-swiftui" in stacks %}
  generate-client-mobile-ios:
    desc: "Generate Swift URLSession client from OpenAPI"
    internal: true
    cmds:
      - >
        {{'{{'}} .OPENAPI_GENERATOR {{'}}'}} generate
        -i {{'{{'}} .OPENAPI_SPEC {{'}}'}}
        -g swift6
        -o ./mobile-ios/Generated/APIClient
        --additional-properties=library=urlsession,projectName={{ ios_module_name }}API
{% endif %}

  # ===========================================================================
  # Cross-Platform Commands
  # ===========================================================================
  lint:
    desc: "Lint all platforms"
    cmds:
{% for app in apps if app.stack == "spring-backend" %}      - task: {{ app.id }}:lint
{% endfor %}
{% for app in apps if app.stack == "nextjs-web" %}      - task: {{ app.id }}:lint
      - task: {{ app.id }}:typecheck
{% endfor %}
{% if "android-compose" in stacks %}
      - task: mobile-android:lint
{% endif %}

  test:
    desc: "Run tests for all platforms"
    cmds:
{% for app in apps if app.stack == "spring-backend" %}      - task: {{ app.id }}:test
{% endfor %}
{% for app in apps if app.stack == "nextjs-web" %}      - task: {{ app.id }}:test
{% endfor %}
{% if "android-compose" in stacks %}
      - task: mobile-android:test
{% endif %}

  # ===========================================================================
  # Utilities
  # ===========================================================================
  validate-api:
    desc: "Validate OpenAPI spec"
    cmds:
      - "{{'{{'}} .OPENAPI_GENERATOR {{'}}'}} validate -i {{'{{'}} .OPENAPI_SPEC {{'}}'}}"
