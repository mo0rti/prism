version: '3'

vars:
  PROJECT_NAME: {{ project_name | tojson }}
  OPENAPI_SPEC: ./shared/api-contracts/openapi.yml
  OPENAPI_GENERATOR: openapi-generator-cli

includes:
{% for app in apps if app.stack == "spring-backend" %}  {{ app.id }}:
    taskfile: {{ ('./' ~ app.path ~ '/Taskfile.yml') | tojson }}
    dir: {{ ('./' ~ app.path) | tojson }}
{% endfor %}
{% for app in apps if app.stack == "nextjs-web" %}  {{ app.id }}:
    taskfile: {{ ('./' ~ app.path ~ '/Taskfile.yml') | tojson }}
    dir: {{ ('./' ~ app.path) | tojson }}
{% endfor %}
{% for app in apps if app.stack == "android-compose" %}  {{ app.id }}:
    taskfile: {{ ('./' ~ app.path ~ '/Taskfile.yml') | tojson }}
    dir: {{ ('./' ~ app.path) | tojson }}
{% endfor %}
{% for app in apps if app.stack == "ios-swiftui" %}  {{ app.id }}:
    taskfile: {{ ('./' ~ app.path ~ '/Taskfile.yml') | tojson }}
    dir: {{ ('./' ~ app.path) | tojson }}
{% endfor %}
{% for app in apps if app.stack == "python-agent-service" %}  {{ app.id }}:
    taskfile: {{ ('./' ~ app.path ~ '/Taskfile.yml') | tojson }}
    dir: {{ ('./' ~ app.path) | tojson }}
{% endfor %}

tasks:
  # ===========================================================================
  # API Client Generation
  # ===========================================================================
  generate-clients:
    desc: "Generate typed API clients from OpenAPI spec for all platforms"
    cmds:
      - cmd: "{{'{{'}} .OPENAPI_GENERATOR {{'}}'}} validate -i {{'{{'}} .OPENAPI_SPEC {{'}}'}}"
{% for app in apps if app.stack == "spring-backend" %}      - task: generate-client-{{ app.id }}
{% endfor %}
{% for app in apps if app.stack == "nextjs-web" %}      - task: {{ app.id }}:generate-api
{% endfor %}
    sources:
      - "{{'{{'}} .OPENAPI_SPEC {{'}}'}}"

{% for app in apps if app.stack == "spring-backend" %}  generate-client-{{ app.id }}:
    desc: "Generate Spring Boot server interfaces of {{ app.id }} from OpenAPI"
    internal: true
    cmds:
      - >
        {{'{{'}} .OPENAPI_GENERATOR {{'}}'}} generate
        -i {{'{{'}} .OPENAPI_SPEC {{'}}'}}
        -g kotlin-spring
        -o "./{{ app.path }}/src/generated"
        --additional-properties=interfaceOnly=true,useSpringBoot3=true,useTags=true
        --package-name="{{ package_identifier }}.{{ app.id | replace('-', '') }}.api"
{% endfor %}

  # ===========================================================================
  # Cross-Platform Commands
  # ===========================================================================
  lint:
    desc: "Lint every web, Android and agent service app (a backend app has no linter; task <app-id>:check runs its Gradle check)"
    cmds:
{% if not ("nextjs-web" in stacks or "android-compose" in stacks or "python-agent-service" in stacks) %}      - echo "No web, Android or agent service app to lint"
{% endif %}
{% for app in apps if app.stack == "nextjs-web" %}      - task: {{ app.id }}:lint
      - task: {{ app.id }}:typecheck
{% endfor %}
{% for app in apps if app.stack == "android-compose" %}      - task: {{ app.id }}:lint
{% endfor %}
{% for app in apps if app.stack == "python-agent-service" %}      - task: {{ app.id }}:lint
      - task: {{ app.id }}:typecheck
{% endfor %}

  test:
    desc: "Run tests for all platforms (an iOS app's unit tests run on macOS only; its tasks skip elsewhere)"
    cmds:
{% for app in apps if app.stack == "spring-backend" %}      - task: {{ app.id }}:test
{% endfor %}
{% for app in apps if app.stack == "nextjs-web" %}      - task: {{ app.id }}:test
{% endfor %}
{% for app in apps if app.stack == "android-compose" %}      - task: {{ app.id }}:test
{% endfor %}
{% for app in apps if app.stack == "ios-swiftui" %}      - task: {{ app.id }}:test-unit
{% endfor %}
{% for app in apps if app.stack == "python-agent-service" %}      - task: {{ app.id }}:test
      - task: {{ app.id }}:eval
{% endfor %}

  # ===========================================================================
  # Utilities
  # ===========================================================================
{% if "spring-backend" in stacks %}  db-up:
    desc: "Start the local PostgreSQL database that the backend apps use"
    cmds:
      - docker compose up -d db

  db-down:
    desc: "Stop the local PostgreSQL database (its data stays in the Docker volume)"
    cmds:
      - docker compose stop db

{% endif %}  validate-api:
    desc: "Validate OpenAPI spec"
    cmds:
      - "{{'{{'}} .OPENAPI_GENERATOR {{'}}'}} validate -i {{'{{'}} .OPENAPI_SPEC {{'}}'}}"
