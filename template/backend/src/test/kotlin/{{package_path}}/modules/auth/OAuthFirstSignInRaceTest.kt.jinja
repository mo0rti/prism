import java.util.UUID
import java.util.concurrent.Callable
import java.util.concurrent.CountDownLatch
import java.util.concurrent.Executors
import java.util.concurrent.TimeUnit

/**
 * A concurrent first sign-in for one provider identity must return the account
 * the other request created instead of failing with a 500.
 *
 * The test commits the "winner" only after the "loser" has looked for an
 * existing account, found none, and started its own insert. That is the exact
 * interleaving behind the unique-constraint race.
 */
@SpringBootTest(
    properties = [
        "spring.jpa.properties.hibernate.session_factory.statement_inspector=" +
            "{{ package_identifier }}.modules.auth.OAuthFirstSignInRaceTest${'$'}UserInsertObserver"
    ]
)
@ActiveProfiles("test")
class OAuthFirstSignInRaceTest {

    /** Reports every `insert into users` statement to the test while it is armed. */
    class UserInsertObserver : StatementInspector {
        override fun inspect(sql: String): String {
            if (sql.startsWith("insert into users")) {
                insertStarted?.countDown()
            }
            return sql
        }

        companion object {
            @Volatile
            var insertStarted: CountDownLatch? = null
        }
    }

    @MockitoBean
    private lateinit var tokenVerifier: OAuthTokenVerifier

    @Autowired
    private lateinit var oAuth2UserService: OAuth2UserService
{% if "google" in auth_methods or "apple" in auth_methods or "facebook" in auth_methods or "microsoft" in auth_methods %}

    @Autowired
    private lateinit var authService: AuthService
{% endif %}

    @Autowired
    private lateinit var userRepository: UserRepository

    @Autowired
    private lateinit var transactionManager: PlatformTransactionManager

    private val createdUsers = mutableListOf<UUID>()

    @AfterEach
    fun cleanUp() {
        UserInsertObserver.insertStarted = null
        userRepository.deleteAllById(createdUsers)
        createdUsers.clear()
    }

    private fun profile() = OAuthUserProfile(
        providerId = "race-subject-${UUID.randomUUID()}",
        email = "race-${UUID.randomUUID()}@example.com",
        displayName = "Racer",
        avatarUrl = null
    )

    /**
     * Inserts the winner without committing, starts [loser], and commits the
     * winner once the loser has begun its own insert. Returns the winner's
     * account and the loser's result.
     */
    private fun <T> raceAgainstUncommittedWinner(profile: OAuthUserProfile, loser: () -> T): Pair<User, T> {
        val winnerTransaction = transactionManager.getTransaction(DefaultTransactionDefinition())
        val executor = Executors.newSingleThreadExecutor()
        var committed = false
        try {
            val winner = userRepository.saveAndFlush(User(
                email = profile.email,
                displayName = "Winner",
                authProvider = AuthProvider.GOOGLE,
                providerId = profile.providerId
            ))
            createdUsers += winner.id

            // Armed after the winner's flush, so only the loser's insert counts.
            val loserInserting = CountDownLatch(1)
            UserInsertObserver.insertStarted = loserInserting
            val result = executor.submit(Callable { loser() })

            val deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(10)
            while (!loserInserting.await(50, TimeUnit.MILLISECONDS)) {
                if (result.isDone) {
                    result.get()
                    fail<Unit>("The loser completed without inserting, so the race was not exercised")
                }
                if (System.nanoTime() > deadline) fail<Unit>("The loser never started its insert")
            }

            transactionManager.commit(winnerTransaction)
            committed = true
            return winner to result.get(10, TimeUnit.SECONDS)
        } finally {
            if (!committed) transactionManager.rollback(winnerTransaction)
            executor.shutdownNow()
        }
    }

    @Test
    fun `loser of a concurrent first sign-in gets the existing account instead of an error`() {
        val profile = profile()
        Mockito.doReturn(profile).`when`(tokenVerifier).verify(AuthProvider.GOOGLE, "id-token", null)

        val (winner, loserResult) = raceAgainstUncommittedWinner(profile) {
            // The request-scoped transaction in AuthService wraps this call.
            TransactionTemplate(transactionManager).execute {
                oAuth2UserService.processOAuthToken("google", "id-token", null)
            }!!
        }

        assertEquals(winner.id, loserResult.id)
        assertEquals(1, userRepository.findAll().count { it.providerId == profile.providerId })
    }
{% if "google" in auth_methods or "apple" in auth_methods or "facebook" in auth_methods or "microsoft" in auth_methods %}

    @Test
    fun `concurrent first sign-in through the auth service returns a session for the existing account`() {
        val profile = profile()
        Mockito.doReturn(profile).`when`(tokenVerifier).verify(AuthProvider.GOOGLE, "id-token", null)

        val (winner, response) = raceAgainstUncommittedWinner(profile) {
            authService.oauthToken(OAuthTokenRequest(provider = "google", idToken = "id-token"))
        }

        assertEquals(winner.id, response.user.id)
        assertEquals(winner.email, response.user.email)
        assertTrue(response.accessToken.isNotBlank())
    }
{% endif %}
}
