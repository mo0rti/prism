import {{ package_identifier }}.modules.auth.dto.RefreshTokenRequest
import {{ package_identifier }}.modules.auth.dto.RegisterRequest
import {{ package_identifier }}.modules.auth.dto.UserResponse
import {{ package_identifier }}.modules.auth.dto.toResponse
import {{ package_identifier }}.modules.auth.error.AuthErrorCode
import {{ package_identifier }}.modules.auth.model.AuthProvider
import {{ package_identifier }}.modules.auth.model.User
import {{ package_identifier }}.modules.auth.model.UserRole
import {{ package_identifier }}.modules.auth.repository.UserRepository
import {{ package_identifier }}.shared.exception.ConflictException
import {{ package_identifier }}.shared.exception.UnauthorizedException
import org.springframework.security.crypto.password.PasswordEncoder
import org.springframework.stereotype.Service
import org.springframework.transaction.annotation.Transactional
import java.time.Instant
import java.util.UUID
import jakarta.persistence.EntityManager

@Service
class AuthService(
    private val userRepository: UserRepository,
    private val jwtTokenProvider: JwtTokenProvider,
    private val oAuth2UserService: OAuth2UserService,
    private val passwordEncoder: PasswordEncoder,
    private val entityManager: EntityManager
) {
    private val dummyPasswordHash = passwordEncoder.encode("timing-attack-placeholder")
{% if "google" in auth_methods or "apple" in auth_methods or "facebook" in auth_methods or "microsoft" in auth_methods %}
    @Transactional
    fun oauthCallback(request: OAuthCallbackRequest): AuthResponse {
        val user = oAuth2UserService.processOAuthCallback(request.provider, request.code, request.redirectUri)
        return createFreshSession(user)
    }

    @Transactional
    fun oauthToken(request: OAuthTokenRequest): AuthResponse {
        val user = oAuth2UserService.processOAuthToken(request.provider, request.idToken, request.accessToken)
        return createFreshSession(user)
    }
{% endif %}

    @Transactional
    fun register(request: RegisterRequest): AuthResponse {
        if (userRepository.existsByEmail(request.email)) {
            throw ConflictException(AuthErrorCode.EMAIL_ALREADY_REGISTERED)
        }

        val user = userRepository.save(
            User(
                email = request.email,
                displayName = request.displayName,
                passwordHash = passwordEncoder.encode(request.password),
                authProvider = AuthProvider.LOCAL
            )
        )

        return createFreshSession(user)
    }

    @Transactional
    fun login(request: LoginRequest, requireAdmin: Boolean = false): AuthResponse {
        val user = userRepository.findByEmail(request.email)?.let { lockedUser(it.id) }
        val passwordHash = user?.passwordHash ?: dummyPasswordHash
        val passwordMatches = passwordEncoder.matches(request.password, passwordHash)
        if (user == null || user.passwordHash == null || !passwordMatches) {
            throw UnauthorizedException(AuthErrorCode.INVALID_CREDENTIALS)
        }
        if (requireAdmin && user.role != UserRole.ADMIN) {
            throw UnauthorizedException(AuthErrorCode.INVALID_CREDENTIALS)
        }

        return createFreshSession(user)
    }

    @Transactional
    fun refreshToken(request: RefreshTokenRequest): AuthResponse {
        if (!jwtTokenProvider.validateRefreshToken(request.refreshToken)) {
            throw UnauthorizedException(AuthErrorCode.INVALID_REFRESH_TOKEN)
        }

        val userId = jwtTokenProvider.getUserIdFromToken(request.refreshToken)
        val user = lockedUser(userId)

        if (!jwtTokenProvider.matchesRefreshTokenVersion(request.refreshToken, user.refreshTokenVersion)) {
            val previous = user.previousRefreshTokenVersion
            val rotatedAt = user.refreshRotatedAt
            if (previous == null || rotatedAt == null ||
                rotatedAt.isAfter(Instant.now()) ||
                !Instant.now().isBefore(rotatedAt.plusSeconds(10)) ||
                !jwtTokenProvider.matchesRefreshTokenVersion(request.refreshToken, previous)) {
                throw UnauthorizedException(AuthErrorCode.INVALID_REFRESH_TOKEN)
            }
            return issueTokens(user)
        }

        user.previousRefreshTokenVersion = user.refreshTokenVersion
        user.refreshRotatedAt = Instant.now()
        user.refreshTokenVersion += 1
        return issueTokens(userRepository.save(user))
    }

    @Transactional
    fun logout(user: User) {
        val current = lockedUser(user.id)
        current.refreshTokenVersion += 1
        current.previousRefreshTokenVersion = null
        current.refreshRotatedAt = null
        userRepository.save(current)
    }

    @Transactional(readOnly = true)
    fun getCurrentUser(user: User): UserResponse = user.toResponse()

    private fun createFreshSession(user: User): AuthResponse {
        val current = lockedUser(user.id)
        current.refreshTokenVersion += 1
        current.previousRefreshTokenVersion = null
        current.refreshRotatedAt = null
        return issueTokens(userRepository.save(current))
    }

    private fun issueTokens(persistedUser: User): AuthResponse {
        return AuthResponse(
            accessToken = jwtTokenProvider.generateAccessToken(persistedUser),
            refreshToken = jwtTokenProvider.generateRefreshToken(persistedUser),
            expiresIn = jwtTokenProvider.getAccessTokenExpiry(),
            user = persistedUser.toResponse()
        )
    }

    private fun lockedUser(id: UUID): User {
        val user = userRepository.findByIdForUpdate(id)
            ?: throw UnauthorizedException(AuthErrorCode.USER_NOT_FOUND)
        // Authentication or provisioning may already have loaded this entity.
        // Refresh under the row lock so the first-level cache cannot lose a rotation.
        entityManager.refresh(user)
        return user
    }
}
