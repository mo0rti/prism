package {{ package_identifier }}.modules.auth.service

import {{ package_identifier }}.modules.auth.model.AuthProvider
import {{ package_identifier }}.modules.auth.model.OAuthUserProfile
import {{ package_identifier }}.modules.auth.model.User
import {{ package_identifier }}.modules.auth.model.normalizedEmail
import {{ package_identifier }}.modules.auth.repository.UserRepository
import {{ package_identifier }}.modules.auth.error.AuthErrorCode
import {{ package_identifier }}.shared.exception.ConflictException
import org.springframework.stereotype.Service
import org.springframework.transaction.annotation.Propagation
import org.springframework.transaction.annotation.Transactional
import jakarta.persistence.EntityManager

@Service
class UserProvisioningService(
    private val userRepository: UserRepository,
    private val entityManager: EntityManager
) {

    /**
     * Runs in its own transaction and flushes the insert before returning, so a
     * concurrent first sign-in that loses the unique-identity race fails here as
     * a [org.springframework.dao.DataIntegrityViolationException]. The caller's
     * transaction is not marked rollback-only and can load the winner's account.
     */
    @Transactional(propagation = Propagation.REQUIRES_NEW)
    fun provisionOAuthUser(provider: AuthProvider, userProfile: OAuthUserProfile): User {
        val existing = userRepository.findOAuthUserForUpdate(provider, userProfile.providerId)
        if (existing != null) {
            // Lock and reload before dirtying the entity. Otherwise AUTO flush
            // could overwrite a concurrent rotation with stale session metadata.
            entityManager.refresh(existing)
            existing.displayName = userProfile.displayName
            existing.avatarUrl = userProfile.avatarUrl
            return userRepository.saveAndFlush(existing)
        }

        val email = userProfile.email.normalizedEmail()
        val byEmail = userRepository.findByEmail(email)
        if (byEmail != null) {
            throw ConflictException(
                AuthErrorCode.OAUTH_ACCOUNT_LINK_REQUIRED,
                message = "An account with email $email already exists. Sign in with the original method before linking $provider."
            )
        }

        return userRepository.saveAndFlush(
            User(
                email = email,
                displayName = userProfile.displayName,
                avatarUrl = userProfile.avatarUrl,
                authProvider = provider,
                providerId = userProfile.providerId
            )
        )
    }

    @Transactional(readOnly = true)
    fun findExistingOAuthUser(provider: AuthProvider, userProfile: OAuthUserProfile): User? =
        userRepository.findByAuthProviderAndProviderId(provider, userProfile.providerId)
}
