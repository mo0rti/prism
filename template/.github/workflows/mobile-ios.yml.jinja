{% if "mobile-ios" in platforms %}
name: iOS CI/CD

on:
  push:
    branches: [main]
    paths:
      - 'mobile-ios/**'
      - 'shared/**'
    tags:
      - 'v*'
  pull_request:
    branches: [main]
    paths:
      - 'mobile-ios/**'
      - 'shared/**'
  workflow_dispatch:

jobs:
  test:
    name: Test
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Create local xcconfig files
        working-directory: mobile-ios
        run: |
          test -f Config/Debug.xcconfig || cp Config/Debug.xcconfig.example Config/Debug.xcconfig
          test -f Config/Release.xcconfig || cp Config/Release.xcconfig.example Config/Release.xcconfig

      - name: Generate Xcode project
        working-directory: mobile-ios
        run: xcodegen generate

      - name: Select iPhone simulator
        run: |
          SIMULATOR_ID=$(xcrun simctl list devices available | grep -E '^ +iPhone ' | grep -Eo '[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12}' | tail -n 1)
          if [ -z "$SIMULATOR_ID" ]; then
            echo "No available iPhone simulator found." >&2
            xcrun simctl list devices available >&2
            exit 1
          fi
          echo "SIMULATOR_ID=$SIMULATOR_ID" >> "$GITHUB_ENV"

      - name: Run tests
        shell: bash
        working-directory: mobile-ios
        run: |
          set -o pipefail
          xcodebuild test \
            -project "{{ project_name }}.xcodeproj" \
            -scheme "{{ ios_module_name }}" \
            -destination "platform=iOS Simulator,id=$SIMULATOR_ID" \
            -resultBundlePath TestResults \
            | xcpretty

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ios-test-results
          path: mobile-ios/TestResults

  release:
    name: Release to TestFlight
    needs: test
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: macos-latest
    environment: production
    env:
      PRISM_RELEASE_CONFIGURED: {% raw %}${{ secrets.ASC_KEY_ID != '' && secrets.ASC_ISSUER_ID != '' && secrets.ASC_KEY_CONTENT != '' && secrets.MATCH_PASSWORD != '' && secrets.MATCH_GIT_URL != '' }}{% endraw %}
    steps:
      - name: Report skipped deploy
        if: env.PRISM_RELEASE_CONFIGURED != 'true'
        run: |
          echo "::warning title=Deploy skipped::Set the ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT, MATCH_PASSWORD and MATCH_GIT_URL secrets to deploy the iOS app to TestFlight. No deploy ran."
          echo "### Deploy skipped" >> "$GITHUB_STEP_SUMMARY"
          echo "The ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_CONTENT, MATCH_PASSWORD and MATCH_GIT_URL secrets are not all set, so the iOS app was not deployed to TestFlight." >> "$GITHUB_STEP_SUMMARY"

      - uses: actions/checkout@v4
        if: env.PRISM_RELEASE_CONFIGURED == 'true'

      - name: Install XcodeGen
        if: env.PRISM_RELEASE_CONFIGURED == 'true'
        run: brew install xcodegen

      - name: Create local xcconfig files
        if: env.PRISM_RELEASE_CONFIGURED == 'true'
        working-directory: mobile-ios
        run: |
          test -f Config/Debug.xcconfig || cp Config/Debug.xcconfig.example Config/Debug.xcconfig
          test -f Config/Release.xcconfig || cp Config/Release.xcconfig.example Config/Release.xcconfig

      - name: Generate Xcode project
        if: env.PRISM_RELEASE_CONFIGURED == 'true'
        working-directory: mobile-ios
        run: xcodegen generate

      - name: Set up Ruby
        if: env.PRISM_RELEASE_CONFIGURED == 'true'
        uses: ruby/setup-ruby@v1
        with:
          ruby-version: '3.2'
          bundler-cache: true
          working-directory: mobile-ios

      - name: Deploy to TestFlight
        if: env.PRISM_RELEASE_CONFIGURED == 'true'
        working-directory: mobile-ios
        env:
          ASC_KEY_ID: {% raw %}${{ secrets.ASC_KEY_ID }}{% endraw %}
          ASC_ISSUER_ID: {% raw %}${{ secrets.ASC_ISSUER_ID }}{% endraw %}
          ASC_KEY_CONTENT: {% raw %}${{ secrets.ASC_KEY_CONTENT }}{% endraw %}
          MATCH_PASSWORD: {% raw %}${{ secrets.MATCH_PASSWORD }}{% endraw %}
          MATCH_GIT_URL: {% raw %}${{ secrets.MATCH_GIT_URL }}{% endraw %}
          GITHUB_RUN_NUMBER: {% raw %}${{ github.run_number }}{% endraw %}
        run: bundle exec fastlane beta
{% endif %}
