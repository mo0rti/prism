{% if "ios-swiftui" in stacks %}
name: iOS CI

on:
  push:
    branches: [main]
    paths:
      - 'mobile-ios/**'
      - 'shared/**'
  pull_request:
    branches: [main]
    paths:
      - 'mobile-ios/**'
      - 'shared/**'
  workflow_dispatch:

jobs:
  test:
    name: Test
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Create local xcconfig files
        working-directory: mobile-ios
        run: |
          test -f Config/Debug.xcconfig || cp Config/Debug.xcconfig.example Config/Debug.xcconfig
          test -f Config/Release.xcconfig || cp Config/Release.xcconfig.example Config/Release.xcconfig

      - name: Generate Xcode project
        working-directory: mobile-ios
        run: xcodegen generate

      - name: Select iPhone simulator
        run: |
          SIMULATOR_ID=$(xcrun simctl list devices available | grep -E '^ +iPhone ' | grep -Eo '[0-9A-F]{8}(-[0-9A-F]{4}){3}-[0-9A-F]{12}' | tail -n 1)
          if [ -z "$SIMULATOR_ID" ]; then
            echo "No available iPhone simulator found." >&2
            xcrun simctl list devices available >&2
            exit 1
          fi
          echo "SIMULATOR_ID=$SIMULATOR_ID" >> "$GITHUB_ENV"

      - name: Run tests
        shell: bash
        working-directory: mobile-ios
        run: |
          set -o pipefail
          xcodebuild test \
            -project "{{ project_name }}.xcodeproj" \
            -scheme "{{ ios_module_name }}" \
            -destination "platform=iOS Simulator,id=$SIMULATOR_ID" \
            -resultBundlePath TestResults \
            | xcpretty

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ios-test-results
          path: mobile-ios/TestResults

{% endif %}
