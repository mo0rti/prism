{% if "android-compose" in stacks %}
name: Android CI

on:
  push:
    branches: [main]
    paths:
      - 'mobile-android/**'
      - 'shared/**'
  pull_request:
    branches: [main]
    paths:
      - 'mobile-android/**'
      - 'shared/**'
  workflow_dispatch:

jobs:
  test:
    name: Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Make Gradle wrapper executable
        run: chmod +x mobile-android/gradlew

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: {% raw %}${{ runner.os }}-gradle-android-${{ hashFiles('mobile-android/**/*.gradle*', 'mobile-android/gradle/libs.versions.toml', 'mobile-android/gradle/wrapper/gradle-wrapper.properties') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-gradle-android-{% endraw %}

      - name: Run tests
        working-directory: mobile-android
        run: ./gradlew compileDebugKotlin compileDebugAndroidTestKotlin testDebugUnitTest

  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Make Gradle wrapper executable
        run: chmod +x mobile-android/gradlew

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: {% raw %}${{ runner.os }}-gradle-android-${{ hashFiles('mobile-android/**/*.gradle*', 'mobile-android/gradle/libs.versions.toml', 'mobile-android/gradle/wrapper/gradle-wrapper.properties') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-gradle-android-{% endraw %}

      - name: Lint
        working-directory: mobile-android
        run: ./gradlew lintDebug

  ui-test:
    name: Instrumentation UI Tests
    needs: test
    runs-on: ubuntu-latest
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@v4

      - name: Make Gradle wrapper executable
        run: chmod +x mobile-android/gradlew

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: {% raw %}${{ runner.os }}-gradle-android-${{ hashFiles('mobile-android/**/*.gradle*', 'mobile-android/gradle/libs.versions.toml', 'mobile-android/gradle/wrapper/gradle-wrapper.properties') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-gradle-android-{% endraw %}

      - name: Run instrumentation / Compose UI tests on emulator
        uses: ReactiveCircus/android-emulator-runner@v2
        with:
          api-level: 36
          target: default
          arch: x86_64
          profile: pixel_6
          disable-animations: true
          working-directory: mobile-android
          script: ./gradlew connectedDebugAndroidTest

      - name: Upload instrumentation reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: android-ui-test-reports
          path: |
            mobile-android/app/build/reports/androidTests/connected/
            mobile-android/app/build/outputs/androidTest-results/connected/

  build:
    name: Build Debug APK
    needs:
      - test
      - lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Make Gradle wrapper executable
        run: chmod +x mobile-android/gradlew

      - name: Set up JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: {% raw %}${{ runner.os }}-gradle-android-${{ hashFiles('mobile-android/**/*.gradle*', 'mobile-android/gradle/libs.versions.toml', 'mobile-android/gradle/wrapper/gradle-wrapper.properties') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-gradle-android-{% endraw %}

      - name: Build debug APK
        working-directory: mobile-android
        run: ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: debug-apk
          path: mobile-android/app/build/outputs/apk/debug/app-debug.apk

{% endif %}
