{% if "web-admin-portal" in platforms %}
name: Admin Web Portal CI

on:
  push:
    branches: [main]
    paths:
      - "web-admin-portal/**"
      - "shared/**"
  pull_request:
    branches: [main]
    paths:
      - "web-admin-portal/**"
      - "shared/**"
  workflow_dispatch:

jobs:
  lint-typecheck-build:
    name: Lint, Typecheck, Build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Install dependencies
        working-directory: web-admin-portal
        run: npm install

      - name: Lint
        working-directory: web-admin-portal
        run: npm run lint

      - name: Typecheck
        working-directory: web-admin-portal
        run: npm run typecheck

      - name: Build
        working-directory: web-admin-portal
        run: npm run build

{% endif %}
