version: "3"

vars:
  GRADLEW: '{{'{{'}}if eq OS "windows"{{'}}'}}gradlew.bat{{'{{'}}else{{'}}'}}./gradlew{{'{{'}}end{{'}}'}}'
  # The port of the backend this app was generated for, on this machine. Override it: `task {{ app_id }}:reverse BACKEND_PORT=<port>`.
  BACKEND_PORT: "{{ backend_port }}"

tasks:
  build:
    desc: Build the {{ app_id }} debug APK
    cmds:
      - "{{'{{'}}.GRADLEW{{'}}'}} assembleDebug"

  test:
    desc: Run the {{ app_id }} unit tests (JVM, the Compose UI test included)
    cmds:
      - "{{'{{'}}.GRADLEW{{'}}'}} testDebugUnitTest"

  lint:
    desc: Run Android lint on {{ app_id }}
    cmds:
      - "{{'{{'}}.GRADLEW{{'}}'}} lintDebug"

  devices:
    desc: List connected Android devices and emulators
    cmds:
      - adb devices

  reverse:
    desc: "Let a device or emulator reach the local backend at localhost:{{'{{'}}.BACKEND_PORT{{'}}'}} (needed for the local development sign-in; run it again after a restart)"
    cmds:
      - "adb reverse tcp:{{'{{'}}.BACKEND_PORT{{'}}'}} tcp:{{'{{'}}.BACKEND_PORT{{'}}'}}"

  install:
    desc: Install the {{ app_id }} debug APK on the connected device or emulator
    cmds:
      - "{{'{{'}}.GRADLEW{{'}}'}} installDebug"

  clean:
    desc: Clean {{ app_id }} build artifacts
    cmds:
      - "{{'{{'}}.GRADLEW{{'}}'}} clean"
