/**
 * The local development sign-in. It names what it is on screen: the backend's development identity,
 * not complete authentication.
 */
@Composable
fun SignInScreen(
    state: SignInUiState,
    onSignInClick: () -> Unit,
    modifier: Modifier = Modifier,
    sessionEnded: Boolean = false,
) {
    Surface(modifier = modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
        Column(
            modifier = Modifier
                .safeDrawingPadding()
                .padding(Spacing.lg),
            verticalArrangement = Arrangement.Center,
            horizontalAlignment = Alignment.CenterHorizontally,
        ) {
            Text(
                text = stringResource(R.string.sign_in_title),
                style = MaterialTheme.typography.headlineMedium,
            )
            Spacer(Modifier.height(Spacing.sm))
            Text(
                text = stringResource(R.string.sign_in_description),
                style = MaterialTheme.typography.bodyMedium,
                color = MaterialTheme.colorScheme.onSurfaceVariant,
            )
            if (sessionEnded) {
                Spacer(Modifier.height(Spacing.md))
                Text(
                    text = stringResource(R.string.sign_in_session_ended),
                    style = MaterialTheme.typography.bodyMedium,
                )
            }
            Spacer(Modifier.height(Spacing.lg))
            Button(
                onClick = onSignInClick,
                enabled = !state.isLoading,
                modifier = Modifier.fillMaxWidth(),
            ) {
                if (state.isLoading) {
                    CircularProgressIndicator(modifier = Modifier.size(Spacing.lg))
                } else {
                    Text(stringResource(R.string.sign_in_action))
                }
            }
            state.error?.let { error ->
                Spacer(Modifier.height(Spacing.md))
                Text(
                    text = stringResource(error.messageResource()),
                    style = MaterialTheme.typography.bodyMedium,
                    color = MaterialTheme.colorScheme.error,
                )
            }
        }
    }
}

private fun SignInError.messageResource(): Int = when (this) {
    SignInError.DevIdentityUnavailable -> R.string.sign_in_error_unavailable
    SignInError.LoopbackOnly -> R.string.sign_in_error_loopback_only
    SignInError.Network -> R.string.sign_in_error_network
    SignInError.Unexpected -> R.string.sign_in_error_unexpected
}

@Preview(showBackground = true)
@Composable
private fun SignInScreenPreview() {
    AppTheme {
        SignInScreen(state = SignInUiState(), onSignInClick = {})
    }
}
