name: {{ ci_workflow_name | tojson }}

on:
  push:
    branches: [main]
    paths:
{%- for path in ci_paths %}
      - {{ path | tojson }}
{%- endfor %}
  pull_request:
    branches: [main]
    paths:
{%- for path in ci_paths %}
      - {{ path | tojson }}
{%- endfor %}
  workflow_dispatch:

permissions:
  contents: read

# One run per app and branch: a newer push cancels the run it replaces.
concurrency:
  group: "{{ app_id }}-{% raw %}${{ github.ref }}{% endraw %}"
  cancel-in-progress: true

env:
  APP_PATH: {{ app_path | tojson }}

jobs:
  build:
    name: Build and test
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v4

      - name: Make Gradle wrapper executable
        run: chmod +x "$APP_PATH/gradlew"

      - name: Set up JDK {{ versions.java }}
        uses: actions/setup-java@v4
        with:
          java-version: '{{ versions.java }}'
          distribution: 'temurin'

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: {% raw %}${{ runner.os }}-gradle-${{ hashFiles(format('{0}/**/*.gradle*', env.APP_PATH), format('{0}/gradle/wrapper/gradle-wrapper.properties', env.APP_PATH)) }}{% endraw %}

      # The runner's Docker daemon serves the integration tests (Testcontainers starts PostgreSQL).
      # The build needs no secret and no production credential.
      - name: Build and run every test
        working-directory: {% raw %}${{ env.APP_PATH }}{% endraw %}
        run: ./gradlew build

      - name: Upload test reports
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-reports
          path: {% raw %}${{ env.APP_PATH }}{% endraw %}/build/reports/tests/
