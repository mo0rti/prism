name: {{ ci_workflow_name | tojson }}

on:
  push:
    branches: [main]
    paths:
{%- for path in ci_paths %}
      - {{ path | tojson }}
{%- endfor %}
  pull_request:
    branches: [main]
    paths:
{%- for path in ci_paths %}
      - {{ path | tojson }}
{%- endfor %}
  workflow_dispatch:

jobs:
  test:
    name: Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Make Gradle wrapper executable
        run: chmod +x {{ app_path }}/gradlew

      - name: Set up JDK {{ versions.java }}
        uses: actions/setup-java@v4
        with:
          java-version: '{{ versions.java }}'
          distribution: 'temurin'

      - name: Cache Gradle
        uses: actions/cache@v4
        with:
          path: |
            ~/.gradle/caches
            ~/.gradle/wrapper
          key: {% raw %}${{ runner.os }}-gradle-${{ hashFiles({% endraw %}'{{ app_path }}/**/*.gradle*', '{{ app_path }}/gradle/wrapper/gradle-wrapper.properties'{% raw %}) }}{% endraw %}

      - name: Run tests
        working-directory: {{ app_path }}
        run: ./gradlew test

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: test-results
          path: {{ app_path }}/build/reports/tests/
