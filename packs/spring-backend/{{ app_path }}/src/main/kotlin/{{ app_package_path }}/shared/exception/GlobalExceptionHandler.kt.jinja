package {{ app_package }}.shared.exception

import {{ app_package }}.shared.error.CommonErrorCode
import {{ app_package }}.shared.model.ApiErrorResponse
import org.slf4j.LoggerFactory
import org.springframework.beans.TypeMismatchException
import org.springframework.http.HttpHeaders
import org.springframework.http.HttpStatus
import org.springframework.http.HttpStatusCode
import org.springframework.http.ResponseEntity
import org.springframework.http.converter.HttpMessageNotReadableException
import org.springframework.security.access.AccessDeniedException
import org.springframework.security.core.AuthenticationException
import org.springframework.web.bind.MethodArgumentNotValidException
import org.springframework.web.bind.annotation.ExceptionHandler
import org.springframework.web.bind.annotation.RestControllerAdvice
import org.springframework.web.context.request.WebRequest
import org.springframework.web.servlet.mvc.method.annotation.ResponseEntityExceptionHandler

/**
 * Maps exceptions to [ApiErrorResponse] bodies.
 *
 * Extending [ResponseEntityExceptionHandler] keeps Spring's own status for
 * client mistakes such as an unknown route (404), a wrong method (405), a bad
 * path variable or a missing parameter (400). Only exceptions nobody handles
 * become a 500, and their details stay in the log.
 */
@RestControllerAdvice
class GlobalExceptionHandler : ResponseEntityExceptionHandler() {

    private val log = LoggerFactory.getLogger(javaClass)

    @ExceptionHandler(ApiException::class)
    fun handleApiException(ex: ApiException): ResponseEntity<Any> {
        log.warn("API error: {} - {}", ex.code, ex.message)
        return ResponseEntity
            .status(ex.status)
            .body(ApiErrorResponse(code = ex.code, message = ex.message, details = ex.details))
    }

    @ExceptionHandler(AccessDeniedException::class)
    fun handleAccessDenied(ex: AccessDeniedException): ResponseEntity<Any> {
        log.debug("Access denied", ex)
        return errorResponse(CommonErrorCode.FORBIDDEN)
    }

    @ExceptionHandler(AuthenticationException::class)
    fun handleAuthentication(ex: AuthenticationException): ResponseEntity<Any> {
        log.debug("Authentication required", ex)
        return errorResponse(CommonErrorCode.UNAUTHORIZED)
    }

    override fun handleMethodArgumentNotValid(
        ex: MethodArgumentNotValidException,
        headers: HttpHeaders,
        status: HttpStatusCode,
        request: WebRequest
    ): ResponseEntity<Any>? {
        val details = ex.bindingResult.fieldErrors.associate { it.field to (it.defaultMessage ?: "invalid") }
        return errorResponse(CommonErrorCode.VALIDATION_ERROR, details = details, headers = headers)
    }

    override fun handleHttpMessageNotReadable(
        ex: HttpMessageNotReadableException,
        headers: HttpHeaders,
        status: HttpStatusCode,
        request: WebRequest
    ): ResponseEntity<Any>? {
        log.debug("Request body could not be read", ex)
        return errorResponse(CommonErrorCode.INVALID_REQUEST, headers = headers)
    }

    override fun handleTypeMismatch(
        ex: TypeMismatchException,
        headers: HttpHeaders,
        status: HttpStatusCode,
        request: WebRequest
    ): ResponseEntity<Any>? {
        log.debug("Request value has the wrong type", ex)
        return errorResponse(
            CommonErrorCode.BAD_REQUEST,
            message = "Invalid value for '${ex.propertyName ?: "request parameter"}'",
            headers = headers
        )
    }

    /** Every other Spring MVC exception keeps its own status and gets a generic body. */
    override fun handleExceptionInternal(
        ex: Exception,
        body: Any?,
        headers: HttpHeaders,
        statusCode: HttpStatusCode,
        request: WebRequest
    ): ResponseEntity<Any>? {
        log.debug("Request rejected with status {}", statusCode.value(), ex)
        val error = when (statusCode.value()) {
            HttpStatus.BAD_REQUEST.value() -> CommonErrorCode.BAD_REQUEST
            HttpStatus.UNAUTHORIZED.value() -> CommonErrorCode.UNAUTHORIZED
            HttpStatus.FORBIDDEN.value() -> CommonErrorCode.FORBIDDEN
            HttpStatus.NOT_FOUND.value() -> CommonErrorCode.NOT_FOUND
            HttpStatus.METHOD_NOT_ALLOWED.value() -> CommonErrorCode.METHOD_NOT_ALLOWED
            HttpStatus.CONFLICT.value() -> CommonErrorCode.CONFLICT
            HttpStatus.UNSUPPORTED_MEDIA_TYPE.value() -> CommonErrorCode.UNSUPPORTED_MEDIA_TYPE
            else -> null
        }
        if (error != null) {
            return errorResponse(error, headers = headers)
        }
        val status = HttpStatus.resolve(statusCode.value())
        if (statusCode.is4xxClientError) {
            return ResponseEntity.status(statusCode).headers(headers).body(
                ApiErrorResponse(code = status?.name ?: CommonErrorCode.BAD_REQUEST.code, message = status?.reasonPhrase ?: CommonErrorCode.BAD_REQUEST.defaultMessage)
            )
        }
        log.error("Unhandled framework exception", ex)
        return errorResponse(CommonErrorCode.INTERNAL_ERROR, headers = headers)
    }

    @ExceptionHandler(Exception::class)
    fun handleGeneric(ex: Exception): ResponseEntity<Any> {
        log.error("Unhandled exception", ex)
        return errorResponse(CommonErrorCode.INTERNAL_ERROR)
    }

    private fun errorResponse(
        error: CommonErrorCode,
        message: String = error.defaultMessage,
        details: Map<String, Any>? = null,
        headers: HttpHeaders = HttpHeaders.EMPTY
    ): ResponseEntity<Any> = ResponseEntity
        .status(error.httpStatus)
        .headers(headers)
        .body(ApiErrorResponse(code = error.code, message = message, details = details))
}
