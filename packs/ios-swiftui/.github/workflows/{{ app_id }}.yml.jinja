name: {{ ci_workflow_name | tojson }}

on:
  push:
    branches: [main]
    paths:
{%- for path in ci_paths %}
      - {{ path | tojson }}
{%- endfor %}
  pull_request:
    branches: [main]
    paths:
{%- for path in ci_paths %}
      - {{ path | tojson }}
{%- endfor %}
  workflow_dispatch:

permissions:
  contents: read

# One run per app and branch: a newer push cancels the run it replaces.
concurrency:
  group: "{{ app_id }}-{% raw %}${{ github.ref }}{% endraw %}"
  cancel-in-progress: true

env:
  APP_PATH: {{ app_path | tojson }}

jobs:
  verify:
    name: Generate, build, test
    # A pinned runner image: the `latest` label moves to a new macOS and a new default Xcode without a change here.
    runs-on: macos-26
    timeout-minutes: 60
    defaults:
      run:
        shell: bash
        working-directory: {% raw %}${{ env.APP_PATH }}{% endraw %}
    steps:
      - uses: actions/checkout@v4

      # The runner image keeps several Xcode versions side by side. The baseline is the pin of the Prism template this
      # app was generated from ({{ versions.xcode }}): select that one, and stop when the image does not have it.
      - name: Select Xcode {{ versions.xcode }}
        run: |
          set -euo pipefail
          PIN="{{ versions.xcode }}"
          APP="$(ls -d "/Applications/Xcode_${PIN}.app" "/Applications/Xcode_${PIN}."*.app 2>/dev/null | sort -V | tail -n 1 || true)"
          if [ -z "$APP" ]; then
            echo "Xcode ${PIN} is not installed on this runner. Installed versions:" >&2
            ls -d /Applications/Xcode*.app >&2 || true
            exit 1
          fi
          echo "DEVELOPER_DIR=${APP}/Contents/Developer" >> "$GITHUB_ENV"
          DEVELOPER_DIR="${APP}/Contents/Developer" xcodebuild -version

      # Homebrew's downloads are the one slow, repeatable part of the setup, so they are cached. Derived data is not:
      # a stale build cache hides the errors this job exists to find.
      - name: Cache Homebrew downloads
        uses: actions/cache@v4
        with:
          path: ~/Library/Caches/Homebrew
          key: {% raw %}${{ runner.os }}{% endraw %}-homebrew-xcodegen

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Generate Xcode project
        run: xcodegen generate

      - name: Select iPhone simulator
        run: |
          set -euo pipefail
          # The runtime must be the simulator SDK of the selected Xcode: a runner image holds only some runtimes.
          SDK_VERSION="$(xcrun --sdk iphonesimulator --show-sdk-version)"
          xcrun simctl list devices available -j > "$RUNNER_TEMP/simulators.json"
          SIMULATOR_ID="$(python3 - "$SDK_VERSION" "$RUNNER_TEMP/simulators.json" <<'PY'
          import json
          import sys

          sdk, path = sys.argv[1], sys.argv[2]
          with open(path, encoding="utf-8") as handle:
              devices = json.load(handle)["devices"]
          runtime = "com.apple.CoreSimulator.SimRuntime.iOS-" + sdk.replace(".", "-")
          phones = [d for d in devices.get(runtime, []) if d.get("isAvailable", True) and d["name"].startswith("iPhone")]
          if not phones:
              print("No available iPhone simulator runs iOS " + sdk + ", the simulator SDK of the selected Xcode. Available runtimes:", file=sys.stderr)
              for key, items in sorted(devices.items()):
                  names = ", ".join(d["name"] for d in items if d.get("isAvailable", True)) or "no device"
                  print("  " + key.replace("com.apple.CoreSimulator.SimRuntime.", "") + ": " + names, file=sys.stderr)
              sys.exit(1)
          print(phones[-1]["udid"])
          PY
          )"
          echo "Using simulator $SIMULATOR_ID (iOS $SDK_VERSION)"
          echo "SIMULATOR_ID=$SIMULATOR_ID" >> "$GITHUB_ENV"

      - name: Build
        run: |
          set -euo pipefail
          xcodebuild build \
            -project "{{ app_module_name }}.xcodeproj" \
            -scheme "{{ app_module_name }}" \
            -destination "platform=iOS Simulator,id=$SIMULATOR_ID" \
            -configuration Debug \
            -derivedDataPath build/DerivedData

      - name: Test
        run: |
          set -euo pipefail
          xcodebuild test \
            -project "{{ app_module_name }}.xcodeproj" \
            -scheme "{{ app_module_name }}" \
            -destination "platform=iOS Simulator,id=$SIMULATOR_ID" \
            -derivedDataPath build/DerivedData \
            -resultBundlePath build/TestResults.xcresult

      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: {{ app_id }}-test-results
          path: {% raw %}${{ env.APP_PATH }}{% endraw %}/build/TestResults.xcresult
          if-no-files-found: ignore
