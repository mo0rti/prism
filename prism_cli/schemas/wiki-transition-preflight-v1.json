{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prism-kit:schema:wiki-transition-preflight:v1",
  "title": "Prism wiki transition preflight envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "experimental",
    "command",
    "root",
    "confidence",
    "workspace",
    "facts",
    "blocker_facts",
    "required_obligations",
    "sources",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experimental": { "type": "boolean" },
    "command": { "const": "wiki transition-preflight" },
    "root": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["high", "degraded", "error"] },
    "workspace": { "$ref": "#/$defs/workspace" },
    "facts": { "$ref": "#/$defs/transition_facts" },
    "blocker_facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "required_obligations": {
      "type": "array",
      "items": { "$ref": "#/$defs/obligation" }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "workspace": {
      "type": "object",
      "required": ["kind", "project_name", "apps"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "project_name": { "type": ["string", "null"] },
        "apps": {
          "type": "array",
          "items": { "$ref": "#/$defs/app" }
        }
      },
      "additionalProperties": true
    },
    "app": {
      "type": "object",
      "required": ["id", "name", "stack", "repository", "path", "audience", "status", "capabilities", "maturity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "stack": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "audience": { "type": ["string", "null"] },
        "status": { "enum": ["active", "retired"] },
        "capabilities": {
          "type": "object",
          "required": ["has-ui", "serves-api"],
          "properties": {
            "has-ui": { "enum": [true, false, "unknown"] },
            "serves-api": { "enum": [true, false, "unknown"] }
          },
          "additionalProperties": false
        },
        "maturity": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "path", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning", "info"] },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "feature_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "obligation": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["path"] },
        { "required": ["count"] }
      ],
      "additionalProperties": true
    },
    "transition_facts": {
      "type": "object",
      "required": ["requested_action", "transition_capability", "feature", "transition", "transitions"],
      "properties": {
        "requested_action": { "type": ["string", "null"] },
        "transition_capability": { "$ref": "#/$defs/transition_capability" },
        "feature": {
          "anyOf": [
            { "$ref": "#/$defs/feature_summary" },
            { "type": "null" }
          ]
        },
        "transition": { "$ref": "#/$defs/transition" },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/transition" }
        }
      },
      "additionalProperties": true
    },
    "feature_summary": {
      "type": "object",
      "required": ["id", "title", "status", "owner", "advisory_review", "apps", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "status": { "type": ["string", "null"] },
        "owner": { "type": ["string", "null"] },
        "advisory_review": { "type": ["string", "null"] },
        "apps": { "type": "array", "items": { "type": "string" } },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "capability_surface": {
      "type": "object",
      "required": ["action", "role", "path", "available", "check"],
      "properties": {
        "action": {
          "enum": [
            "po-specify",
            "po-handoff",
            "design-start",
            "design-handoff",
            "dev-start",
            "dev-done",
            "reopen-spec",
            "reopen-design",
            "reopen-dev"
          ]
        },
        "role": { "enum": ["codex", "claude"] },
        "path": { "type": "string", "minLength": 1 },
        "available": { "type": "boolean" },
        "check": { "enum": ["pass", "unknown"] },
        "invocation_template": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "transition_snapshot": {
      "type": "object",
      "required": ["fingerprint", "observed_at", "consistent"],
      "properties": {
        "fingerprint": { "type": "string", "minLength": 1 },
        "observed_at": {
          "type": "string",
          "minLength": 1,
          "description": "First observation time for this cached content fingerprint; unchanged snapshots may reuse this timestamp across reads. It is the first observation of a cached content snapshot, not every read."
        },
        "consistent": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "transition_capability": {
      "type": "object",
      "required": ["version", "mode", "supported_actions", "snapshot", "sources", "surfaces"],
      "properties": {
        "version": { "const": 2 },
        "mode": { "const": "copy-only" },
        "supported_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "po-specify",
              "po-handoff",
              "design-start",
              "design-handoff",
              "dev-start",
              "dev-done",
              "reopen-spec",
              "reopen-design",
              "reopen-dev"
            ]
          }
        },
        "snapshot": { "$ref": "#/$defs/transition_snapshot" },
        "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "surfaces": {
          "type": "array",
          "items": { "$ref": "#/$defs/capability_surface" }
        }
      },
      "additionalProperties": true
    },
    "transition_check": {
      "type": "object",
      "required": ["code", "status", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "blocked", "unknown", "review"] },
        "message": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "transition": {
      "type": "object",
      "required": [
        "version",
        "feature_id",
        "source_status",
        "source_owner",
        "source_path",
        "target_status",
        "target_owner",
        "action",
        "classification",
        "supported",
        "checks",
        "sources",
        "reason"
      ],
      "properties": {
        "version": { "const": 1 },
        "feature_id": { "type": "string", "minLength": 1 },
        "source_status": { "type": ["string", "null"] },
        "source_owner": { "type": ["string", "null"] },
        "source_path": { "type": ["string", "null"] },
        "target_status": {
          "type": ["string", "null"],
          "enum": ["specified", "ready-for-design", "in-design", "ready-for-dev", "in-dev", "done", null]
        },
        "target_owner": { "type": ["string", "null"] },
        "action": {
          "type": ["string", "null"],
          "enum": [
            "po-specify",
            "po-handoff",
            "design-start",
            "design-handoff",
            "dev-start",
            "dev-done",
            "reopen-spec",
            "reopen-design",
            "reopen-dev",
            null
          ]
        },
        "classification": { "enum": ["ready", "blocked", "unknown"] },
        "supported": {
          "type": "boolean",
          "description": "Whether the source status/owner maps to an action and the evaluator can establish its copy capability. Unknown integrity or capability checks can make this false. A blocked action may still be supported; true does not mean the feature is ready or approved. Copying additionally requires classification ready and a consistent snapshot."
        },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/transition_check" } },
        "sources": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 },
        "invocations": {
          "type": "object",
          "properties": {
            "codex": { "type": "string", "minLength": 1 },
            "claude": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
