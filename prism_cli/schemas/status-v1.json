{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prism-kit:schema:status:v1",
  "title": "Prism workspace status envelope v1",
  "type": "object",
  "required": [
    "schema_version",
    "experimental",
    "command",
    "root",
    "confidence",
    "workspace",
    "facts",
    "blocker_facts",
    "required_obligations",
    "sources",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "experimental": { "type": "boolean" },
    "command": { "const": "status" },
    "root": { "type": "string", "minLength": 1 },
    "confidence": { "enum": ["high", "degraded", "error"] },
    "workspace": { "$ref": "#/$defs/workspace" },
    "facts": { "type": "object" },
    "blocker_facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "required_obligations": {
      "type": "array",
      "items": { "$ref": "#/$defs/obligation" }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    }
  },
  "$defs": {
    "workspace": {
      "type": "object",
      "required": ["kind", "project_name", "apps", "repositories"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "project_name": { "type": ["string", "null"] },
        "purpose": { "const": "knowledge-root" },
        "apps": {
          "type": "array",
          "items": { "$ref": "#/$defs/app" }
        },
        "repositories": {
          "type": "array",
          "items": { "$ref": "#/$defs/repository" }
        }
      },
      "additionalProperties": true
    },
    "app": {
      "type": "object",
      "required": ["id", "name", "stack", "repository", "path", "audience", "status", "capabilities", "maturity"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "stack": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "audience": { "type": ["string", "null"] },
        "status": { "enum": ["active", "retired"] },
        "capabilities": {
          "type": "object",
          "required": ["has-ui", "serves-api"],
          "properties": {
            "has-ui": { "enum": [true, false, "unknown"] },
            "serves-api": { "enum": [true, false, "unknown"] }
          },
          "additionalProperties": false
        },
        "maturity": {
          "type": ["object", "null"],
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": ["id", "remote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "remote": { "type": ["string", "null"] },
        "checkout": { "enum": ["resolved", "unresolved"] }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity", "path", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["error", "warning", "info"] },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "feature_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "obligation": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["path"] },
        { "required": ["count"] }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
